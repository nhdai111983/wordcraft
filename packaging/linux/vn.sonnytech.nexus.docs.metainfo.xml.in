<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>vn.sonnytech.nexus.docs</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Nexus Docs</name>
  <summary>Write and design documents; open and save Word files</summary>
  <developer id="vn.sonnytech">
    <name>Sonnytech</name>
  </developer>
  <description>
    <p>
      Nexus Docs, part of the NexusOffices suite by Sonnytech, is a fast, open-source word processor with a familiar ribbon: styles, tables, track changes, references, mail merge, and .docx, PDF, ODT, RTF, HTML and Markdown files. It can be driven by AI agents over MCP. It is based on the open-source WordCraft by the ArtCraft team (MIT OR Apache-2.0).
    </p>
  </description>
  <launchable type="desktop-id">vn.sonnytech.nexus.docs.desktop</launchable>
  <icon type="stock">vn.sonnytech.nexus.docs</icon>
  <url type="bugtracker">https://github.com/nhdai111983/wordcraft/issues</url>
  <url type="help">https://github.com/nhdai111983/wordcraft</url>
  <categories>
    <category>Office</category>
    <category>WordProcessor</category>
  </categories>
  <keywords>
    <keyword>word processor</keyword>
    <keyword>docx</keyword>
    <keyword>document</keyword>
    <keyword>writer</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#99d6cf</color>
    <color type="primary" scheme_preference="dark">#0f766e</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <!-- Document types Nexus Docs opens (#295), as in the desktop entry's MimeType=. -->
  <provides>
    <binary>nexus-docs</binary>
    <mediatype>application/vnd.openxmlformats-officedocument.wordprocessingml.document</mediatype>
    <mediatype>application/vnd.ms-word.document.macroEnabled.12</mediatype>
    <mediatype>application/vnd.openxmlformats-officedocument.wordprocessingml.template</mediatype>
    <mediatype>application/vnd.ms-word.template.macroEnabled.12</mediatype>
    <mediatype>application/msword</mediatype>
    <mediatype>application/msword-template</mediatype>
    <mediatype>application/vnd.oasis.opendocument.text</mediatype>
    <mediatype>application/rtf</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
