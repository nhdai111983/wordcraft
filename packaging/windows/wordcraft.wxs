<?xml version="1.0" encoding="utf-8"?>
<!--
  Nexus Docs MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus its UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2` and the same for WixToolset.Util.wixext).
  Built by package.ps1:

    wix build wordcraft.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -d Version=1.2.3 -d BinDir=... -d IconPath=... -d LicenseRtf=... -o out.msi

  Per-machine install into Program Files with a Start Menu shortcut. The installer shows the
  standard WiX dialogs: welcome + license, progress, and a finish page.

  UpgradeCode and the component GUIDs below belong to Nexus Docs alone. Never copy them from (or
  into) a sibling Craft app: Windows Installer treats every package sharing an UpgradeCode as one
  product, so a shared code makes one app's installer refuse to install ("a newer version is
  already installed") or silently uninstall the other. packaging-lint.yml checks this.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- NexusOffices: package.ps1 passes FontLicences=yes when it staged licenses\ (the OFL texts of
       the embedded fonts); a build without that folder (a smoke test) leaves the group out. -->
  <?ifndef FontLicences ?>
  <?define FontLicences = "no" ?>
  <?endif ?>
  <Package
      Name="Nexus Docs"
      Manufacturer="Sonnytech"
      Version="$(var.Version)"
      UpgradeCode="B8F9CA5A-7CB4-4C4D-A260-DFC010020560"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Nexus Docs word processor" Manufacturer="Sonnytech" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Nexus Docs is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="WordcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="WordcraftIcon.ico" />

    <!-- Installer UI (#198): WixUI_Minimal is welcome + license, progress, then a finish page so
         people can see the install worked. Its dialogs and bitmaps are WiX's own
         (WixToolset.UI.wixext); package.ps1 builds the license RTF from LICENSE-MIT and
         LICENSE-APACHE. The finish page offers to launch Nexus Docs (ticked by default) through
         WixShellExec (WixToolset.Util.wixext); silent installs (/qn) never show it. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Nexus Docs" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#WordcraftExe]" />
    <CustomAction Id="LaunchWordcraft" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec"
        Impersonate="yes" Return="ignore" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchWordcraft"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Nexus Docs">
        <?if $(var.FontLicences) = "yes" ?>
        <Directory Id="LicensesFolder" Name="licenses" />
        <?endif ?>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Nexus Docs" Level="1">
      <ComponentGroupRef Id="WordcraftFiles" />
      <?if $(var.FontLicences) = "yes" ?>
      <ComponentGroupRef Id="WordcraftFontLicences" />
      <?endif ?>
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="WordcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="WordcraftApp" Guid="817F98F7-FA47-45DC-B404-2CB8E089B5CD">
        <File Id="WordcraftExe" Source="$(var.BinDir)\wordcraft.exe" Name="nexus-docs.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Nexus Docs"
              Description="Nexus Docs word processor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="WordcraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\nexus-docs.exe" Value="[#WordcraftExe]" Type="string" />
      </Component>

      <!-- File associations (#295). Each document type gets a Nexus Docs ProgId (name, icon, open
           command) and is listed under the extension's OpenWithProgids, so Nexus Docs shows in
           Explorer's "Open with". The Word, RTF and ODT types are also Nexus Docs's Capabilities
           (RegisteredApplications), so it appears in Settings › Default apps, where the user
           makes it the default (File › Options › General opens that page). Nothing here sets an
           extension's default: the installer never takes over .docx from another app. Markdown and
           plain text are only "Open with" candidates. Removed again on uninstall. -->
      <Component Id="WordcraftFileTypes" Guid="18759204-C532-417D-B43D-41C0A4D0376E">
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="NexusDocs" Value="Software\Sonnytech\Nexus Docs\Capabilities" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Sonnytech\Nexus Docs\Capabilities" Name="ApplicationName" Value="Nexus Docs" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Sonnytech\Nexus Docs\Capabilities" Name="ApplicationDescription" Value="Write and design documents; open and save Word files." Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Sonnytech\Nexus Docs\Capabilities" Name="ApplicationIcon" Value="&quot;[#WordcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\nexus-docs.exe" Name="FriendlyAppName" Value="Nexus Docs" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\nexus-docs.exe\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />

        <ProgId Id="Sonnytech.NexusDocs.Document" Description="Word Document" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Sonnytech.NexusDocs.Document\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.docx\OpenWithProgids" Name="Sonnytech.NexusDocs.Document" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\nexus-docs.exe\SupportedTypes" Name=".docx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Sonnytech\Nexus Docs\Capabilities\FileAssociations" Name=".docx" Value="Sonnytech.NexusDocs.Document" Type="string" />

        <ProgId Id="Sonnytech.NexusDocs.DocumentMacroEnabled" Description="Word Macro-Enabled Document" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Sonnytech.NexusDocs.DocumentMacroEnabled\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.docm\OpenWithProgids" Name="Sonnytech.NexusDocs.DocumentMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\nexus-docs.exe\SupportedTypes" Name=".docm" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Sonnytech\Nexus Docs\Capabilities\FileAssociations" Name=".docm" Value="Sonnytech.NexusDocs.DocumentMacroEnabled" Type="string" />

        <ProgId Id="Sonnytech.NexusDocs.Template" Description="Word Template" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Sonnytech.NexusDocs.Template\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dotx\OpenWithProgids" Name="Sonnytech.NexusDocs.Template" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\nexus-docs.exe\SupportedTypes" Name=".dotx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Sonnytech\Nexus Docs\Capabilities\FileAssociations" Name=".dotx" Value="Sonnytech.NexusDocs.Template" Type="string" />

        <ProgId Id="Sonnytech.NexusDocs.TemplateMacroEnabled" Description="Word Macro-Enabled Template" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Sonnytech.NexusDocs.TemplateMacroEnabled\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dotm\OpenWithProgids" Name="Sonnytech.NexusDocs.TemplateMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\nexus-docs.exe\SupportedTypes" Name=".dotm" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Sonnytech\Nexus Docs\Capabilities\FileAssociations" Name=".dotm" Value="Sonnytech.NexusDocs.TemplateMacroEnabled" Type="string" />

        <ProgId Id="Sonnytech.NexusDocs.LegacyDocument" Description="Legacy Word Document" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Sonnytech.NexusDocs.LegacyDocument\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.doc\OpenWithProgids" Name="Sonnytech.NexusDocs.LegacyDocument" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\nexus-docs.exe\SupportedTypes" Name=".doc" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Sonnytech\Nexus Docs\Capabilities\FileAssociations" Name=".doc" Value="Sonnytech.NexusDocs.LegacyDocument" Type="string" />

        <ProgId Id="Sonnytech.NexusDocs.LegacyTemplate" Description="Legacy Word Template" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Sonnytech.NexusDocs.LegacyTemplate\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dot\OpenWithProgids" Name="Sonnytech.NexusDocs.LegacyTemplate" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\nexus-docs.exe\SupportedTypes" Name=".dot" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Sonnytech\Nexus Docs\Capabilities\FileAssociations" Name=".dot" Value="Sonnytech.NexusDocs.LegacyTemplate" Type="string" />

        <ProgId Id="Sonnytech.NexusDocs.RichText" Description="Rich Text Document" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Sonnytech.NexusDocs.RichText\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.rtf\OpenWithProgids" Name="Sonnytech.NexusDocs.RichText" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\nexus-docs.exe\SupportedTypes" Name=".rtf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Sonnytech\Nexus Docs\Capabilities\FileAssociations" Name=".rtf" Value="Sonnytech.NexusDocs.RichText" Type="string" />

        <ProgId Id="Sonnytech.NexusDocs.OpenDocumentText" Description="OpenDocument Text" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Sonnytech.NexusDocs.OpenDocumentText\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.odt\OpenWithProgids" Name="Sonnytech.NexusDocs.OpenDocumentText" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\nexus-docs.exe\SupportedTypes" Name=".odt" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Sonnytech\Nexus Docs\Capabilities\FileAssociations" Name=".odt" Value="Sonnytech.NexusDocs.OpenDocumentText" Type="string" />

        <ProgId Id="Sonnytech.NexusDocs.Markdown" Description="Markdown Document" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Sonnytech.NexusDocs.Markdown\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.md\OpenWithProgids" Name="Sonnytech.NexusDocs.Markdown" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\nexus-docs.exe\SupportedTypes" Name=".md" Value="" Type="string" />

        <ProgId Id="Sonnytech.NexusDocs.PlainText" Description="Text Document" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Sonnytech.NexusDocs.PlainText\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.txt\OpenWithProgids" Name="Sonnytech.NexusDocs.PlainText" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\nexus-docs.exe\SupportedTypes" Name=".txt" Value="" Type="string" />
      </Component>

      <Component Id="WordcraftCli">
        <File Id="WordcraftCliExe" Source="$(var.BinDir)\wordcraft-cli.exe" Name="nexus-docs-cli.exe" KeyPath="yes" />
      </Component>
      <!-- NexusOffices: the licences, NOTICE (Apache-2.0 4(d)) and ATTRIBUTION.md, staged by
           package.ps1, are installed beside the binaries. Auto GUIDs, like the CLI component. -->
      <Component Id="WordcraftMitLicense">
        <File Id="WordcraftMitLicenseFile" Source="$(var.BinDir)\LICENSE-MIT" KeyPath="yes" />
      </Component>
      <Component Id="WordcraftApacheLicense">
        <File Id="WordcraftApacheLicenseFile" Source="$(var.BinDir)\LICENSE-APACHE" KeyPath="yes" />
      </Component>
      <Component Id="WordcraftNotice">
        <File Id="WordcraftNoticeFile" Source="$(var.BinDir)\NOTICE" KeyPath="yes" />
      </Component>
      <Component Id="WordcraftAttribution">
        <File Id="WordcraftAttributionFile" Source="$(var.BinDir)\ATTRIBUTION.md" KeyPath="yes" />
      </Component>
    </ComponentGroup>
    <?if $(var.FontLicences) = "yes" ?>
    <!-- NexusOffices: OFL texts of the embedded fonts, staged by package.ps1 in licenses\, one
         auto-GUID component each. -->
    <ComponentGroup Id="WordcraftFontLicences" Directory="LicensesFolder">
      <Files Include="$(var.BinDir)\licenses\*" />
    </ComponentGroup>
    <?endif ?>
  </Fragment>
</Wix>
